# 2026-08-05: CC is supplied on the SPOOLES make line, and the build log is then checked.
#
# WHY THE MAKE LINE.  SPOOLES's Make.inc opens with ".POSIX:", which makes GNU make default
# CC to c99 rather than cc, and every CC assignment in Make.inc is commented out.  Apple's
# c99 rejects every -f option, so the shipped recipe died on its first compile
# ("c99: illegal option -- f") and this tree could not be built by `make` alone -- only by
# install.sh's spooles_rescue(), which is why the working recipe had drifted out of the
# tree and into CI YAML and a skill script.  A command-line assignment outranks every
# assignment inside the makefiles, so the CC below is the one that is actually used.
#
# UNLIKE dd/gmp this directory is NOT generated by configure -- spooles/Makefile is a
# hand-written, tracked file with no Makefile.in -- so the compiler ./configure selected is
# not visible here.  SPOOLES_CC therefore defaults to make's own CC (cc: clang on macOS,
# gcc on Linux; both accept the flag set, verified).  Override it explicitly to match a
# non-default toolchain:   make SPOOLES_CC=gcc-16
SPOOLES_CC = $(CC)

all: build/libspooles.a

build/libspooles.a:
	rm -rf build ; mkdir build ; cd build ; tar xvfz ../archive/spooles.2.2.tgz
	cd build ; patch -p0 < ../patches/patch-ETree+src+makeGlobalLib 
	cd build ; patch -p0 < ../patches/patch-A2+makefile
	cd build ; patch -p0 < ../patches/patch-IVL+src+makeGlobalLib
	cd build ; patch -p0 < ../patches/patch-MPI+makefile
	cd build ; patch -p0 < ../patches/patch-MPI+src+makeGlobalLib
	cd build ; patch -p0 < ../patches/patch-MT+drivers+AllInOneMT.c
	cd build ; patch -p0 < ../patches/patch-MT+makefile
	cd build ; patch -p0 < ../patches/patch-Make.inc
	cd build ; patch -p0 < ../patches/patch-TZ
	cd build ; patch -p0 < ../patches/patch-Tree+src+makeGlobalLib
	cd build ; patch -p0 < ../patches/patch-Utilities+src+makeGlobalLib
	cd build ; patch -p0 < ../patches/patch-makefile
	( cd build ; ${MAKE} global -f makefile CC='$(SPOOLES_CC)' ) > build/spooles-build.log 2>&1 \
	  || { cat build/spooles-build.log >&2 ; \
	       echo "SPOOLES build FAILED; full log: spooles/build/spooles-build.log" >&2 ; \
	       exit 1 ; }
	@grep -q -- '-funroll-all-loops' build/spooles-build.log \
	  || { echo "ERROR: no SPOOLES compile line carries the patched CFLAGS -- patch-Make.inc did not take effect" >&2 ; exit 1 ; }
	@grep -q -- '-Wno-error=int-conversion' build/spooles-build.log \
	  || { echo "ERROR: no SPOOLES compile line carries the GCC-14 -Wno-error flags" >&2 ; exit 1 ; }
	@test -s build/spooles.a \
	  || { echo "ERROR: SPOOLES reported success but produced no spooles.a" >&2 ; exit 1 ; }
	cd build ; cp spooles.a libspooles.a
	@echo "SPOOLES built with CC=$(SPOOLES_CC); log spooles/build/spooles-build.log"
	
clean:
	rm -rf build

dist:
	
distdir:
	
