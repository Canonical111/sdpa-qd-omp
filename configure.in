nl
dnl Configure for SDPA-QD 7.1.2
dnl

AC_INIT(sdpa-qd, 7.1.2)
AM_INIT_AUTOMAKE
AC_PROG_CC
AC_PROG_CXX
AC_CANONICAL_HOST

AC_ARG_WITH(system-spooles,
[  --with-system-spooles      Use spooles already on system],
WITH_SYSTEM_SPOOLES=$withval, WITH_SYSTEM_SPOOLES=no)
AM_CONDITIONAL(BUILD_SPOOLES, test x$WITH_SYSTEM_SPOOLES = xno)

AC_ARG_WITH(system-mpack,
[  --with-system-mpack      Use mpack already on system],
WITH_SYSTEM_MPACK=$withval, WITH_SYSTEM_MPACK=no)
AM_CONDITIONAL(BUILD_MPACK, test x$WITH_SYSTEM_MPACK = xno)

AC_ARG_WITH(qd-includedir,
[  --with-qd-includedir    Gives qd include dir you use(e.g., /usr/local/include).],
QD_INCLUDEDIR=$withval
)

AC_ARG_WITH(qd-libdir,
[  --with-qd-libdir    Gives qd lib dir you use(e.g., /usr/local/lib).],
QD_LIBDIR=$withval
)

AC_ARG_WITH(mpack-includedir,
[  --with-mpack-includedir    Gives mpack include dir you use(e.g., /usr/local/include).],
MPACK_INCLUDEDIR=$withval
)

AC_ARG_WITH(mpack-libdir,
[  --with-mpack-libdir    Gives mpack lib dir you use(e.g., /usr/local/lib).],
MPACK_LIBDIR=$withval
)

AC_ARG_WITH(spooles-includedir,
[  --with-spooles-includedir    Gives spooles include dir you use(e.g., /usr/local/include/spooles).],
SPOOLES_INCLUDEDIR=$withval
)

AC_ARG_WITH(spooles-libdir,
[  --with-spooles-libdir    Gives spooles lib dir you use(e.g., /usr/local/lib).],
SPOOLES_LIBDIR=$withval
)

AC_ARG_ENABLE(metis,
[  --enable-metis    Build with metis],
[case "${enableval}" in
  yes) with_metis=yes ;;
  no)  with_metis=no  ;;
  *) AC_MSG_ERROR(bad value ${enableval} for --enable-metis) ;;
esac],[with_metis=no])
AM_CONDITIONAL(ENABLE_METIS, test x$with_metis = xyes)

AC_ARG_WITH(metis-includedir,
[  --with-metis-includedir    Gives metis include dir you use(e.g., /usr/local/include/metis).],
METIS_INCLUDEDIR=$withval
)

AC_ARG_WITH(metis-libdir,
[  --with-metis-libdir    Gives metis lib dir you use(e.g., /usr/local/lib).],
METIS_LIBDIR=$withval
)

AC_ARG_ENABLE(openmp,
[  --enable-openmp       Enables openmp
],,)

AC_ARG_WITH(openmplib,
[  --with-openmplib    Gives openmplib],
OPENMPLIB=$withval
)

AC_ARG_WITH(openmpflag,
[  --with-openmpflag    Gives openmpflag],
OPENMPFLAG=$withval
)

AC_ARG_WITH(openmpthreads,
[  --with-openmpthread   Gives openmpthreads],
OPENMPTHREADS=$withval
)

AC_ARG_ENABLE(shared,
[  --enable-shared       Enables shared link to the libraries (slower)
],,)

AC_ARG_ENABLE(fp-contract,
[  --enable-fp-contract=MODE  pin FP contraction: off|on|fast|default (default: default,
                          i.e. add no flag).  See the block after AC_SUBST(CXXFLAGS).
],,)


dnl spooles and metis requires -lm when linking.
LIBS="-lm"

dnl How thread we link thread library esp. needed for spooles.
case "$host" in
        *-*-linux*|*-*-uclinux*)
            pthread_cflags="-D_REENTRANT"
            pthread_lib="-lpthread"
            ;;
        *-*-freebsd*|*-*-dragonfly*)
            pthread_cflags=""
            pthread_lib="-pthread"
            ;;
        *-apple-darwin*)
           enable_shared="yes"
        ;;
esac
LIBS="$LIBS $pthread_lib"
CXXFLAGS="$CXXFLAGS $pthread_cflags"
AC_SUBST(pthread_lib)

CFLAGS="$CFLAGS -O2 -funroll-all-loops"
CXXFLAGS="$CXXFLAGS -O2 -funroll-all-loops"
AC_SUBST(CFLAGS)
AC_SUBST(CXXFLAGS)

FPCONTRACT_BAD=no
# 2026-08-05: --enable-fp-contract, ported from the dd fork's B4 (4d5aea5 plumbing,
# 52a686f default flipped).  It pins -ffp-contract so that arm64 and x86-64 execute the
# same arithmetic: on arm64 the compiler is free to fold a*b+c into a single FMA with one
# rounding instead of two, and QD's error-free transformations (two_sum / two_prod, which
# ARE the algorithm) depend on the rounding they were written against.  In dd this pin made
# the arm64 build match the published x86 reference on 20 of 20 problems.
#
# DEFAULT IS `default` HERE, i.e. NO FLAG -- deliberately NOT dd's `off`.  Two reasons, and
# the first one is specific to this fork:
#
#  1. THE PIN CANNOT BE COMPLETE IN THIS FORK YET.  qd does not bundle QD -- there is no
#     external/ directory and no AC_CONFIG_SUBDIRS; configure.in locates an ALREADY BUILT
#     libqd via --with-qd-{includedir,libdir} (AC_CHECK_LIB(qd, c_qd_sqrt) below).  Of the
#     qd_real operations the solver uses, +, -, * and += are inline in <qd/qd_inline.h>
#     (lines 408, 459, 663, 432) and so are compiled into THIS package's translation units
#     and do receive this flag; but operator/ and sqrt() are QD_API and out-of-line in
#     libqd.a (qd_real.h:185-189, 157, 103-105), so they keep whatever flags the cached
#     library was built with and CANNOT receive it from here.  Both are hot: the
#     Cholesky-inverse Rtrsm divides by the diagonal (mpack/Rtrsm.cpp:168) and sqrt is on
#     the Rpotf2 / Rnrm2 / Rlartg / Rsterf / Rsteqr paths.  Making this the default today
#     would therefore produce a THIRD arithmetic -- matching neither the published qd arm64
#     numbers nor the published x86 ones -- while still invalidating the former.  The
#     missing half lives in skills/install-sdpa-omp/scripts/install.sh, which builds and
#     caches libqd (QD build at :148) and passes it no CFLAGS/CXXFLAGS at all, so the cache
#     is built with the compiler default -ffp-contract=fast.  That script must forward the
#     pin AND put a contraction tag in the cache key at :133, or a pinned build silently
#     reuses the unpinned cached libqd.
#  2. THE COST IS UNMEASURED FOR THIS FORK.  dd measured 1.0% per iteration at 1 thread and
#     1.7% at 8, against a per-cell repeat spread of 0.1-3.1%.  That number is not
#     transferable: a qd_real product is ~30-40x more elementary double operations than a
#     dd_real one, so the fraction of the runtime exposed to contraction is a different
#     quantity.  This project has already been burned six times by carrying an unmeasured
#     number across a boundary.
#
# So the plumbing lands inert, and flipping the default is a separate decision that needs
# (a) install.sh forwarding the pin into the cached libqd, and (b) an arm64-vs-x86 identity
# run plus a cost measurement on the published qd set.  See patches/port_notes/.
#
# WHY PLAIN SHELL AND NOT AC_COMPILE_IFELSE.  `configure` is TRACKED in this repository and
# was generated by autoconf 2.62 / automake 1.10.1, versions not available here to
# regenerate with.  Plain shell is emitted verbatim, so this block is byte-identical in
# configure.in and in configure and the two can be diffed against each other.  Same reason
# as the OpenMP probe further down.  If this tree ever moves to a modern autoconf, replace
# the probe with AC_COMPILE_IFELSE and delete this paragraph.
if test -z "$enable_fp_contract"; then
  enable_fp_contract=default
fi
FPCONTRACT_FLAG=""
case "$enable_fp_contract" in
  default|no)
    FPCONTRACT_FLAG=""
    ;;
  off|on|fast)
    FPCONTRACT_FLAG="-ffp-contract=$enable_fp_contract"
    ;;
  *)
    echo "configure: error: bad value '$enable_fp_contract' for --enable-fp-contract." >&2
    echo "configure: error: Use off, on, fast, or default (adds no flag at all)." >&2
    FPCONTRACT_BAD=yes
    ;;
esac
if test x"$FPCONTRACT_FLAG" != x; then
  # A flag the compiler silently drops is worse than no flag: it would produce a build that
  # claims to be pinned and is not.  Compile a real a*b+c and refuse to continue if $CXX
  # will not take the option.
  cat > conftest_fpc.cpp <<'EOF_FPC_CONFTEST'
double f(double a, double b, double c) { return a * b + c; }
int main() { return f(1.0, 2.0, 3.0) > 0.0 ? 0 : 1; }
EOF_FPC_CONFTEST
  if $CXX $CPPFLAGS $CXXFLAGS $FPCONTRACT_FLAG $LDFLAGS -o conftest_fpc conftest_fpc.cpp >/dev/null 2>&1; then
    echo "checking whether $CXX accepts $FPCONTRACT_FLAG... yes" >&6
  else
    echo "configure: error: $CXX does not accept $FPCONTRACT_FLAG." >&2
    echo "configure: error: Refusing to continue rather than produce a build that reports" >&2
    echo "configure: error: itself as contraction-pinned while the flag was discarded." >&2
    FPCONTRACT_BAD=yes
  fi
  rm -rf conftest_fpc conftest_fpc.cpp conftest_fpc.dSYM
fi
if test x"$FPCONTRACT_BAD" = xyes; then
  AC_MSG_ERROR([--enable-fp-contract: see the errors above])
fi
if test x"$FPCONTRACT_FLAG" != x; then
  dnl Both languages: spooles is C, and a pin that is C++-only would leave half the
  dnl program on the other arithmetic.  Appended AFTER the -O2 line above and
  dnl Makefile.in:693 puts $(CXXFLAGS) LAST, after $(sdpa_qd_CXXFLAGS), so it reaches
  dnl every SDPA and mpack translation unit and wins over anything set there.
  CFLAGS="$CFLAGS $FPCONTRACT_FLAG"
  CXXFLAGS="$CXXFLAGS $FPCONTRACT_FLAG"
fi
AC_SUBST([FPCONTRACT_FLAG])

dnl some dummy settings
if test x$SPOOLES_INCLUDEDIR = x; then
SPOOLES_INCLUDEDIR="."
fi
if test x$SPOOLES_LIBDIR = x; then
SPOOLES_LIBDIR="."
fi

dnl

AC_MSG_CHECKING([whether to enable metis])
if test "$with_metis" = "no"; then
  AC_MSG_RESULT([no])
  ENABLE_METIS=NO
  AC_SUBST(ENABLE_METIS)
else
  AC_MSG_RESULT([yes])
  ENABLE_METIS=YES
  AC_SUBST(ENABLE_METIS)

  if test x$METIS_INCLUDEDIR = x; then
  METIS_INCLUDEDIR="."
  fi
  if test x$METIS_LIBDIR = x; then
  METIS_LIBDIR="."
  fi

  dnl Check for METIS include and library files
  HAVE_METIS_HEADER=""
  HAVE_METIS=""
  save_CPPFLAGS="$CPPFLAGS"
  CPPFLAGS="$CPPFLAGS -I$METIS_INCLUDEDIR"
  AC_CHECK_HEADER(metis.h, HAVE_METIS_HEADER=yes)
  CPPFLAGS=$save_CPPFLAGS
  if test x$HAVE_METIS_HEADER = xyes; then
    save_LDFLAGS="$LDFLAGS"
    LDFLAGS="$LDFLAGS -L$METIS_LIBDIR"
    AC_CHECK_LIB(metis, METIS_NodeND, [METIS_LIBS="-lmetis"; HAVE_METIS=yes])
    LDFLAGS=$save_LDFLAGS
  fi

  if test x$HAVE_METIS != xyes; then
    echo "Please install METIS"
    echo "METIS http://glaros.dtc.umn.edu/gkhome/views/metis/index.html"
    AC_MSG_ERROR([No METIS found])
  fi
  AC_SUBST(METIS_LIBDIR)
  AC_SUBST(METIS_INCLUDEDIR)
fi

if test x$WITH_SYSTEM_SPOOLES != xno; then
  dnl Check for SPOOLES include and library files
  HAVE_SPOOLES_HEADER=""
  HAVE_SPOOLES=""
  save_CPPFLAGS="$CPPFLAGS"
  CPPFLAGS="$CPPFLAGS -I$SPOOLES_INCLUDEDIR"
  AC_CHECK_HEADER(SPOOLES.h, HAVE_SPOOLES_HEADER=yes)
  CPPFLAGS=$save_CPPFLAGS

  if test x$HAVE_SPOOLES_HEADER = xyes; then
    save_LDFLAGS="$LDFLAGS"
    LDFLAGS="$LDFLAGS -L$SPOOLES_LIBDIR"
    AC_CHECK_LIB(spooles, InpMtx_init, [SPOOLES_LIB="-lspooles"; HAVE_SPOOLES=yes])
    LDFLAGS=$save_LDFLAGS
  fi

  if test x$HAVE_SPOOLES != xyes; then
    echo "Please install SPOOLES"
    echo "SPOOLES http://www.netlib.org/linalg/spooles/spooles.2.2.html"
    AC_MSG_ERROR([No SPOOLES found])
  fi
else
SPOOLES_LIBDIR=`pwd`/spooles/build
SPOOLES_INCLUDEDIR=`pwd`/spooles/build
fi
AC_SUBST(SPOOLES_LIBDIR)
AC_SUBST(SPOOLES_INCLUDEDIR)

dnl Check for QD include and library files
dnl some dummy settings
if test x$QD_INCLUDEDIR = x; then
QD_INCLUDEDIR="."
fi
if test x$QD_LIBDIR = x; then
QD_LIBDIR="."
fi

HAVE_QD_HEADER=""
HAVE_QD=""
AC_LANG_PUSH([C++])
save_CPPFLAGS="$CPPFLAGS"
CPPFLAGS="$CPPFLAGS -I$QD_INCLUDEDIR"
AC_CHECK_HEADER(qd/qd_real.h, HAVE_QD_HEADER=yes)
CPPFLAGS=$save_CPPFLAGS

if test x$HAVE_QD_HEADER = xyes; then
  save_LDFLAGS="$LDFLAGS"
  LDFLAGS="$LDFLAGS -L$QD_LIBDIR"
  AC_CHECK_LIB(qd, c_qd_sqrt, [QD_LIBS="-lqd"; HAVE_QD=yes])
  LDFLAGS=$save_LDFLAGS
fi

if test x$HAVE_QD != xyes; then
  echo "Please install QD"
  echo "Double-Double and Quad-Double Arithmetic http://www.cs.berkeley.edu/~yozo/"
  AC_MSG_ERROR([No QD found])
fi
AC_SUBST(QD_LIBDIR)
AC_SUBST(QD_INCLUDEDIR)

dnl Check for MPACK include and library files
dnl some dummy settings
if test x$MPACK_INCLUDEDIR = x; then
MPACK_INCLUDEDIR="."
fi
if test x$MPACK_LIBDIR = x; then
MPACK_LIBDIR="."
fi

if test x$WITH_SYSTEM_MPACK != xno; then
HAVE_MPACK_HEADER=""
HAVE_MPACK=""
save_CPPFLAGS="$CPPFLAGS"
CPPFLAGS="$CPPFLAGS -I$MPACK_INCLUDEDIR"
AC_LANG_PUSH([C++])
AC_CHECK_HEADER(mblas_qd.h, HAVE_MPACK_HEADER=yes)
CPPFLAGS=$save_CPPFLAGS

if test x$HAVE_MPACK_HEADER = xyes; then
  save_LDFLAGS="$LDFLAGS"
  LDFLAGS="$LDFLAGS -L$MPACK_LIBDIR"
  LIBS="$LDFLAGS -L$MPACK_LIBDIR -lmlapack_qd -lmblas_qd -lqd";
 # AC_CHECK_FUNC(Rsyev, [HAVE_MPACK=yes])
  HAVE_MPACK=yes
  LDFLAGS=$save_LDFLAGS
fi

if test x$HAVE_MPACK != xyes; then
  echo "Please install MPACK (MBLAS/MLAPACK)"
  echo "MPACK (MBLAS/MLAPACK) http://mplapack.cvs.sourceforge.net/"
  AC_MSG_ERROR([No MPACK found])
fi
else
MPACK_LIBDIR=`pwd`/mpack
MPACK_INCLUDEDIR=`pwd`/mpack
fi
AM_CONDITIONAL(SYSTEM_MPACK, test x$with_system_mpack = xyes)
AC_SUBST(MPACK_LIBDIR)
AC_SUBST(MPACK_INCLUDEDIR)

dnl openmp
# 2026-08-05: --enable-openmp used to be INERT.  AC_ARG_ENABLE(openmp) above declares the
# option with an empty action, and this block expanded $OPENMPFLAG -- which is set ONLY by
# --with-openmpflag, has no default, and AC_OPENMP was never called.  So
# `./configure --enable-openmp` added "-DENABLE_OPENMP -DNUM_OF_THREADS=" to the compile
# line and nothing else: no -fopenmp, no OpenMP runtime.  Neither of those two macros has a
# reader anywhere in this tree -- the live switch is the compiler-supplied _OPENMP -- so the
# binary came out byte-identical to one built with OpenMP never mentioned at all -- verified
# at the object level: same md5, and ZERO GOMP symbols where a -fopenmp build of the very
# same sources carries a hundred or more.  It
# still accepted OMP_NUM_THREADS and still printed the same iteration table, so it reported
# exactly 1.00x at every thread count -- indistinguishable in program output from a genuinely
# threaded build.  That is the danger: the published qd benchmark matrix could be
# "reproduced" with a serial binary and nobody would see it.
# See patches/b5_notes/02_premise_b_enable_openmp_inert.md for the object-level proof.
#
# The probe below is plain shell rather than AC_OPENMP on purpose: `configure` is tracked in
# this repository and was generated by autoconf 2.62 / automake 1.10.1, versions not
# available here to regenerate with.  Plain shell is emitted verbatim, so this block is
# byte-identical in configure.in and in configure and the two can be diffed against each
# other.  If this tree is ever moved to a modern autoconf, delete the probe and call
# AC_OPENMP instead.
WITH_OPENMP=NO
if test -n "$enable_openmp" && test "$enable_openmp" != "no"; then
  if test -z "$OPENMPFLAG"; then
    for ac_omp_try in -fopenmp -qopenmp -xopenmp -openmp -mp -omp; do
      cat > conftest_omp.cpp <<'EOF_OMP_CONFTEST'
#include <omp.h>
#ifndef _OPENMP
#error "compiler accepted the flag but did not define _OPENMP"
#endif
int main() {
  int n = 0;
#pragma omp parallel for reduction(+ : n)
  for (int i = 0; i < 4; i++) n = n + omp_get_thread_num();
  return n < 0 ? 1 : 0;
}
EOF_OMP_CONFTEST
      if $CXX $CPPFLAGS $CXXFLAGS $ac_omp_try $LDFLAGS -o conftest_omp conftest_omp.cpp >/dev/null 2>&1; then
        OPENMPFLAG=$ac_omp_try
        rm -rf conftest_omp conftest_omp.cpp conftest_omp.dSYM
        break
      fi
      rm -rf conftest_omp conftest_omp.cpp conftest_omp.dSYM
    done
  fi
  if test -z "$OPENMPFLAG"; then
    echo "configure: error: --enable-openmp was given, but no OpenMP flag works with $CXX." >&2
    echo "configure: error: Refusing to continue rather than silently produce a SERIAL binary" >&2
    echo "configure: error: that still reports 1.00x at every thread count -- see the comment" >&2
    echo "configure: error: above.  Pass --with-openmpflag=FLAG (and --with-openmplib=LIB if" >&2
    echo "configure: error: the runtime is not linked by FLAG) if your toolchain needs one." >&2
    AC_MSG_ERROR([--enable-openmp given but no working OpenMP flag found])
  fi
  echo "checking for the C++ compiler flag that enables OpenMP... $OPENMPFLAG" >&6
  if test -z "$OPENMPLIB"; then
    # Makefile.am puts $(OPENMPLIB) in sdpa_qd_LDADD and the default link is -static, so the
    # OpenMP runtime has to be named on the link line.  The compiler driver flag is the
    # portable way to do that; a bare -lgomp can fail to resolve GOMP_* under -static
    # depending on where it lands in the library order.
    OPENMPLIB=$OPENMPFLAG
  fi
  OPENMPFLAGS="$OPENMPFLAG -DENABLE_OPENMP"
  # "-DNUM_OF_THREADS=" (defined to the empty string) used to be emitted unconditionally.
  # Nothing in this tree reads NUM_OF_THREADS, and an empty definition would be a syntax
  # error at any use site; emit it only when --with-openmpthreads supplied a value.
  if test -n "$OPENMPTHREADS"; then
    OPENMPFLAGS="$OPENMPFLAGS -DNUM_OF_THREADS=$OPENMPTHREADS"
  fi
  WITH_OPENMP=YES
fi
AC_SUBST(OPENMPLIB)
AC_SUBST(OPENMPFLAGS)

AM_CONDITIONAL(ENABLE_SHARED, test x$enable_shared = xyes)

AC_OUTPUT(Makefile)
